{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "outDir": "./node_modules/.cache/vite-config",
    "tsBuildInfoFile": "./node_modules/.cache/vite-config/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "src/backend/**/*", "src/types.ts"]
}
