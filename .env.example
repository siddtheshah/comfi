# Local installation paths and configuration for ComFi
# Copy this file to .env and adjust the paths to match your local environment.

# Directory containing Solana CLI binaries (solana, solana-keygen, solana-test-validator).
# Leave empty to download the pinned CLI into .localnet-tools on first localnet run,
# or specify a directory containing an existing installation.
SOLANA_BIN_DIR=

# Directory containing Anchor CLI binary (anchor). Leave empty to download the
# pinned CLI into .localnet-tools, or specify a directory containing anchor.
ANCHOR_BIN_DIR=

# Node.js binary path or command name (leave empty to auto-detect node or node.exe)
NODE_BIN=

# Optional cache location for automatically downloaded Solana and Anchor CLIs.
# Defaults to .localnet-tools in the repository.
COMFI_LOCALNET_TOOLS_DIR=

# Solana localnet RPC endpoint
COMFI_LOCALNET_RPC=http://127.0.0.1:8899

# Isolated ledger directory for localnet (outside repo)
LOCALNET_LEDGER_DIR=/tmp/comfi-localnet-ledger

# Payer keypair for deploying to localnet
LOCALNET_PAYER_KEYPAIR=/tmp/comfi-local-payer.json

# Workspace root directory in the shell environment (leave empty to auto-detect from script location)
WORKSPACE_DIR=

# Web UI configuration (all required by frontend, no magic defaults)
VITE_WALLET_MODE=mock
VITE_SOLANA_RPC=http://127.0.0.1:8899
VITE_PROGRAM_ID=3vzvgpB5MWB2cHGPRzWtRmKeQtZVfkffu6uygjoNDDYP
VITE_MOCK_WALLET_PUBLIC_KEY=GmaDrppBC7P5ARKV8g3djiwP89vz1jLK23V2GBjuAEGB

# Optional: needed when the initial VITE_SOLANA_RPC uses a custom hostname.
VITE_SOLANA_NETWORK=localnet
# Optional per-network RPC overrides for the navbar switcher.
VITE_LOCALNET_RPC=http://127.0.0.1:8899
VITE_DEVNET_RPC=https://api.devnet.solana.com
VITE_TESTNET_RPC=https://api.testnet.solana.com
# Optional cluster-specific ComFi program IDs; otherwise VITE_PROGRAM_ID is used.
VITE_DEVNET_PROGRAM_ID=
VITE_TESTNET_PROGRAM_ID=
