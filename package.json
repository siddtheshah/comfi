{
  "name": "comfi",
  "private": true,
  "version": "0.1.0",
  "description": "Community finance workspace",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@comfi/web",
    "dev:testing": "npm run dev --workspace=@comfi/testing",
    "build": "npm run build --workspace=@comfi/web",
    "build:testing": "npm run build --workspace=@comfi/testing",
    "test": "npm run test:localnet-tools && npm run build --workspace=@comfi/sponsor-api && npm run test --workspaces --if-present",
    "test:localnet-tools": "bash scripts/test-localnet-tools.sh",
    "typecheck": "npm run typecheck --workspace=@comfi/web && npm run build --workspace=@comfi/sponsor-api && npm run check --workspace=@comfi/sponsor-api && npm run typecheck --workspace=@comfi/testing",
    "localnet:start": "bash scripts/localnet-start.sh",
    "localnet:setup": "bash scripts/localnet-setup.sh",
    "localnet:create-test-pool": "node scripts/create-test-pool.mjs",
    "keeper:crank": "node scripts/crank-keeper.mjs",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@playwright/test": "^1.55.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "@types/bn.js": "^5.1.6",
    "bn.js": "^5.2.2",
    "playwright": "^1.55.0"
  }
}
